    provider_transaction_id: 'ch_3XYZ...',
    transaction_type: 'capture',
    status: 'CAPTURED',
    amount: 99.99,
    idempotency_key: 'evt_stripe_payment_intent_succeeded_123',
    triggered_by: 'webhook'
  );

  -- Refund (triggered by admin)
  INSERT INTO osc_transaction VALUES (
    order_id: 'ORD-123',
    provider_name: 'stripe',
    provider_transaction_id: 're_3DEF...',
    transaction_type: 'refund',
    status: 'REFUNDED',
    amount: 99.99,
    idempotency_key: 'admin-123-20251009-143022',
    triggered_by: 'admin',
    reason: 'Customer requested refund'
  );
end note

@enduml

